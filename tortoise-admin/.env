# 数据库配置
SPRING_DATASOURCE_HOST=192.168.3.11
SPRING_DATASOURCE_PORT=3306
SPRING_DATASOURCE_DATABASE=db_tortoise
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=usiytvsiid5843

# 服务器配置（新增）
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# 数据源连接池配置
DATASOURCE_MAX_POOL_SIZE=10
DATASOURCE_MIN_IDLE=5
DATASOURCE_IDLE_TIMEOUT=30000
DATASOURCE_MAX_LIFETIME=1800000
DATASOURCE_CONNECTION_TIMEOUT=30000

# 日志配置
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# 上传文件配置
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB
TEMP_FILE_PATH=tmp/excel-import

# Thymeleaf配置
THYMELEAF_CACHE=false

# 线程池配置 - Common
COMMON_CORE_POOL_SIZE=5
COMMON_MAX_POOL_SIZE=20
COMMON_QUEUE_CAPACITY=100
COMMON_KEEP_ALIVE_SECONDS=60
COMMON_AWAIT_TERMINATION_SECONDS=60

# 线程池配置 - After Chat
AFTER_CHAT_CORE_POOL_SIZE=5
AFTER_CHAT_MAX_POOL_SIZE=20
AFTER_CHAT_QUEUE_CAPACITY=100
AFTER_CHAT_KEEP_ALIVE_SECONDS=60
AFTER_CHAT_AWAIT_TERMINATION_SECONDS=60
AFTER_CHAT_THREAD_PREFIX=Async-Service-

# 线程池配置 - Import Conversation
IMPORT_CONVERSATION_CORE_POOL_SIZE=5
IMPORT_CONVERSATION_MAX_POOL_SIZE=20
IMPORT_CONVERSATION_QUEUE_CAPACITY=100
IMPORT_CONVERSATION_KEEP_ALIVE_SECONDS=60
IMPORT_CONVERSATION_AWAIT_TERMINATION_SECONDS=60
IMPORT_CONVERSATION_THREAD_PREFIX=ImportExcel-

# 线程池配置 - Batch Refresh Memory
BATCH_REFRESH_MEMORY_CORE_POOL_SIZE=5
BATCH_REFRESH_MEMORY_MAX_POOL_SIZE=20
BATCH_REFRESH_MEMORY_QUEUE_CAPACITY=100
BATCH_REFRESH_MEMORY_KEEP_ALIVE_SECONDS=60
BATCH_REFRESH_MEMORY_AWAIT_TERMINATION_SECONDS=60
BATCH_REFRESH_MEMORY_THREAD_PREFIX=BatchRefreshMemoryExecutor-