graph TB
%% ========== 样式定义 ==========
classDef client fill:#1890ff,stroke:#096dd9,stroke-width:3px,color:white,font-weight:bold,font-size:14px,rx:8,ry:8
classDef dependencies fill:#f8f9fa,stroke:#adb5bd,stroke-width:1.5px,stroke-dasharray: 5 5,font-size:13px
classDef admin fill:#d0ebff,stroke:#339af0,stroke-width:2px,rx:6,ry:6
classDef core fill:#fff3bf,stroke:#fab005,stroke-width:2px,rx:6,ry:6
classDef interface fill:#e7f5ff,stroke:#339af0,stroke-width:1.5px,font-style:italic
classDef memoryManager fill:#d3f9d8,stroke:#51cf66,stroke-width:2px
classDef formatter fill:#ffe8cc,stroke:#ff922b,stroke-width:2px
classDef adminManager fill:#ffc9c9,stroke:#ff6b6b,stroke-width:2px
classDef component fill:#e6dbff,stroke:#845ef7,stroke-width:2px
classDef adminClient fill:#495057,stroke:#212529,stroke-width:2.5px,color:white,font-weight:bold
classDef config fill:#f3d9fa,stroke:#cc5de8,stroke-width:1.5px,rx:4,ry:4
classDef entity fill:#ffdeeb,stroke:#f06595,stroke-width:1.5px,rx:4,ry:4
classDef mysql fill:#20c997,stroke:#0ca678,stroke-width:2px,color:white

    %% ========== 布局开始 ==========

    %% 顶层：客户端入口
    TC["🚀 Tortoise Client"]:::client

    %% ========== Core Layer - 简化布局 ==========
    subgraph CoreLayer ["💼 Core Layer "]
        direction LR

        %% 左侧：管理器区域
        subgraph LeftGroup ["Managers"]
            direction TB

            %% 接口在最上
            M_Interface["📋 TortoiseChatManager<br/><small>Interface</small>"]:::interface

            %% 两个实现垂直排列
            M_Memory["⚡ Memory-based<br/>DefaultTortoiseChatManager"]:::memoryManager
            M_Admin["👑 Admin-based<br/>AdminTortoiseChatManager"]:::adminManager

            M_Interface --> M_Memory
            M_Interface --> M_Admin
        end

        %% 中间：消息处理器
        subgraph CenterGroup ["Message Handler"]
            H_Interface["📝 TortoiseMessageHandler<br/><small>Interface</small>"]:::interface
            H_Impl["🔧 DefaultTortoiseMessageHandler"]:::formatter

            H_Interface --> H_Impl
        end

        %% 右侧：服务客户端
        subgraph RightGroup ["Service Clients"]
            direction TB
            TAC["🔑 Admin <br/>TortoiseAdminClient"]:::adminClient
            CLC["🔗 CompleteLLMClient"]:::component
            SLC["🌊 StreamLLMAsyncClient"]:::component
        end
    end

    %% ========== 数据管理层 ==========
    subgraph DataLayer ["🗂️ Admin Layer"]
        direction TB

        %% 配置区域在上
        subgraph ConfigGroup ["Configurations"]
            C1["🎯 ChatProfile"]:::config
            C2["💾 MemoryPolicy"]:::config
            C3["🤖 LLMConfig"]:::config
        end

        %% 实体区域在下
        subgraph EntityGroup ["Entities"]
            E1["💬 Conversation"]:::entity
            E2["🧠 Memory"]:::entity
            E3["📨 Message"]:::entity
            E4["📊 Usage"]:::entity
            E5["👤 User"]:::entity
        end

        %% 数据库在底部
        DB["💾 MySQL Database"]:::mysql
    end

    %% ========== 外部依赖层 ==========
    subgraph ExternalLayer ["🌐 External Services"]
        direction LR
        D1["🤖 LLM Providers"]:::dependencies
        D2["🔌 Other Services"]:::dependencies
    end

    %% ========== 清晰的连接关系 ==========

    %% 客户端直接调用（简洁的垂直连接）
    TC --> M_Interface
    TC --> H_Interface
    TC --> TAC
    TC --> CLC
    TC --> SLC

    %% Core层内部的关键依赖（水平连接，不交叉）
    M_Admin -->|"requires"| TAC
    M_Memory -->|"in-memory"| MEM["💨 RAM"]
    H_Impl -->|"formatting"| FORMAT["✨ Formatter"]

    %% 服务网关到数据层（单一清晰连接）
    TAC ==>|"exclusive access"| DataLayer

    %% LLM客户端到外部服务（向右直接连接）
    CLC --> D1
    SLC --> D1



    %% 数据层内部关系（分组内连接）
    C1 --> C2
    C1 --> C3
    E1 --> E2
    E1 --> E3
    E1 --> E4
    E1 --> E5

    ConfigGroup --> DB
    EntityGroup --> DB

    %% ========== 样式应用 ==========
    class CoreLayer core
    class DataLayer admin
    class ExternalLayer dependencies